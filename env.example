# ==============================================================================
# Deployment & Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in the values:
#   cp env.example .env
# Ensure .env is never committed to source control!

# ------------------------------------------------------------------------------
# 1. Domain & SSL / Certbot Settings (AWS Lightsail)
# ------------------------------------------------------------------------------
DOMAIN=api.realgoodresearch.com
CERTBOT_EMAIL=admin@realgoodresearch.com

# ------------------------------------------------------------------------------
# 2. AWS Lightsail Server Configuration
# ------------------------------------------------------------------------------
# Static public IPv4 address assigned to the Lightsail instance
LIGHTSAIL_STATIC_PUBLIC_IP=203.0.113.10

# Address assigned to Lightsail by the existing WireGuard VPN
LIGHTSAIL_WG_ADDRESS=YOUR_LIGHTSAIL_VPN_ADDRESS_WITH_PREFIX

# Lightsail WireGuard Keypair
# Generate on Lightsail: wg genkey | tee client_private.key | wg pubkey > client_public.key
LIGHTSAIL_WG_PRIVATE_KEY=YOUR_LIGHTSAIL_PRIVATE_KEY_HERE
LIGHTSAIL_WG_PUBLIC_KEY=YOUR_LIGHTSAIL_PUBLIC_KEY_HERE
LIGHTSAIL_WG_PRESHARED_KEY=YOUR_LIGHTSAIL_PRESHARED_KEY_HERE

# ------------------------------------------------------------------------------
# 3. Existing VPN and SocialWatcher Configuration
# ------------------------------------------------------------------------------
VPN_SERVER_PUBLIC_KEY=YOUR_EXISTING_VPN_SERVER_PUBLIC_KEY
VPN_SERVER_ENDPOINT=YOUR_EXISTING_VPN_SERVER_HOST_OR_IP
VPN_SERVER_PORT=51820
SERENITY_IP=192.168.50.5
SOCIALWATCHER_PORT=8000
WG_ALLOWED_IPS=192.168.50.5/32
WG_PERSISTENT_KEEPALIVE=25
